        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Pet Adoption System Architecture\n\nskinparam componentStyle rectangle\n\nactor User\nactor Shelter\nactor Admin\n\ncomponent \&quot;Frontend (React.js)\&quot; {\n    [User Interface] \n    [Admin Panel] \n    [Shelter Dashboard]\n}\n\ncomponent \&quot;Backend (Express.js &amp; Node.js)\&quot; {\n    [Auth Controller]\n    [Pet Controller]\n    [User Controller]\n    [Shelter Controller]\n}\n\ncomponent \&quot;Database (MongoDB)\&quot; {\n    [Users Collection]\n    [Pets Collection]\n    [Shelters Collection]\n    [Adoption Requests]\n}\n\nUser --&gt; [User Interface] : Uses\nShelter --&gt; [Shelter Dashboard] : Manages\nAdmin --&gt; [Admin Panel] : Manages\n\n[User Interface] --&gt; [Auth Controller] : API Requests\n[Shelter Dashboard] --&gt; [Pet Controller] : API Requests\n[Admin Panel] --&gt; [User Controller] : API Requests\n[Admin Panel] --&gt; [Shelter Controller] : API Requests\n\n[Auth Controller] --&gt; [Users Collection] : Read/Write\n[Pet Controller] --&gt; [Pets Collection] : Read/Write\n[User Controller] --&gt; [Users Collection] : Read/Write\n[Shelter Controller] --&gt; [Shelters Collection] : Read/Write\n\n[Pet Controller] --&gt; [Adoption Requests] : Manage Adoption Requests\n[Shelter Controller] --&gt; [Pets Collection] : Add/Update/Delete Pets\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="L5qrZIrO2F9hHZTDin7y-1">
